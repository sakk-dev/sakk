{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sakk-gold-trace.v1",
  "type": "object",
  "required": [
    "run_id",
    "case_id",
    "git_commit",
    "model_provider",
    "model_id",
    "prompt_or_packet_version",
    "started_at",
    "ended_at",
    "duration_ms",
    "tool_calls",
    "state_transitions",
    "files_changed",
    "commands_executed",
    "test_results",
    "budget_reserved_usd",
    "actual_cost_usd",
    "final_claim",
    "evidence_paths",
    "errors"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "case_id": { "type": "string" },
    "git_commit": { "type": "string" },
    "model_provider": { "type": "string", "enum": ["FAKE_EXECUTOR", "anthropic", "none"] },
    "model_id": { "type": ["string", "null"] },
    "prompt_or_packet_version": { "type": "string" },
    "started_at": { "type": "string" },
    "ended_at": { "type": "string" },
    "duration_ms": { "type": "number", "minimum": 0 },
    "tool_calls": { "type": "array" },
    "state_transitions": { "type": "array" },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "commands_executed": { "type": "array" },
    "test_results": { "type": "array" },
    "budget_reserved_usd": { "type": "number", "minimum": 0 },
    "actual_cost_usd": { "type": "number", "minimum": 0 },
    "final_claim": { "type": "string", "enum": ["PASS", "BLOCKED", "ESCALATED", "FAIL"] },
    "evidence_paths": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array" }
  }
}
