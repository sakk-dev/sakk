{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sakk-policy.v1",
  "type": "object",
  "required": ["schema", "default_verdict", "rules"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "enum": ["sakk-policy.v1"] },
    "default_verdict": {
      "type": "string",
      "enum": ["allow", "deny", "require_approval"]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "match", "verdict"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "verdict": {
            "type": "string",
            "enum": ["allow", "deny", "require_approval"]
          },
          "approvers_min": { "type": "integer", "minimum": 1 },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "agent": { "type": "string", "minLength": 1 },
              "action": { "type": "string", "minLength": 1 },
              "scope": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1, "pattern": "^[^/*][^*]*$" }
              },
              "max_estimated_usd": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    }
  }
}
