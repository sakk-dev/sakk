{
  "name": "sakk",
  "version": "0.4.1",
  "displayName": "Sakk",
  "description": "A fail-closed guard for Claude Code: a daily spend cap, a secret guard, and policy rules — no proof, no pass.",
  "author": { "name": "The Sakk authors", "url": "https://github.com/sakk-dev" },
  "homepage": "https://github.com/sakk-dev/sakk#readme",
  "repository": "https://github.com/sakk-dev/sakk.git",
  "license": "Apache-2.0",
  "keywords": ["security", "spend-cap", "secret-guard", "fail-closed", "ai-agents"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/sakk.mjs", "hook", "--agent", "claude-code"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
