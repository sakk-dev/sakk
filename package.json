{
  "name": "sakk",
  "version": "0.1.0",
  "description": "The original check, rebuilt for AI agents — a fail-closed spend ledger: reserve before you spawn, settle with real costs, refuse everything pathological.",
  "type": "module",
  "main": "src/ledger.mjs",
  "exports": {
    ".": "./src/ledger.mjs",
    "./policy": "./src/policy.mjs"
  },
  "bin": {
    "sakk": "bin/sakk.mjs"
  },
  "scripts": {
    "test": "node --test --import ./test/bounded-spawn.mjs --test-timeout=300000 test/*.test.mjs",
    "test:eval": "node eval/bin/gold-runner.mjs --validate && node --test --import ./test/bounded-spawn.mjs --test-timeout=300000 eval/__tests__/*.test.mjs",
    "test:all": "npm test && npm run test:eval",
    "drill": "sh scripts/mutation-drill.sh",
    "format": "npx -y prettier@3.9.10 --write .",
    "format:check": "npx -y prettier@3.9.10 --check .",
    "lint": "npx -y eslint@10.13.0 --max-warnings=0 .",
    "gate": "bash scripts/gate.sh",
    "fuzz": "node scripts/invariant-fuzz.mjs",
    "fuzz:policy": "node scripts/policy-fuzz.mjs",
    "fuzz:l1": "node scripts/l1-fuzz.mjs",
    "brief": "node scripts/findings-brief.mjs",
    "hooks": "node scripts/hooks/install.mjs",
    "prepare": "node scripts/hooks/install.mjs",
    "findings:check": "node scripts/findings-check.mjs",
    "inbox": "node scripts/findings-inbox.mjs",
    "campaigns": "node scripts/campaign/fault-injection.mjs && node scripts/campaign/soak-ledger.mjs --minutes 0.2 --workers 4 && node scripts/campaign/mcp-torture.mjs --minutes 0.25 --servers 2",
    "certificate": "node scripts/gate-certificate.mjs",
    "evidence": "node scripts/evidence-bundle.mjs",
    "audit": "node scripts/audit.mjs",
    "golden-k": "node scripts/golden-k.mjs",
    "attack-asr": "node scripts/attack-asr.mjs",
    "findings-report": "node scripts/findings-report.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "keywords": [
    "ai-agents",
    "budget",
    "spend-gate",
    "ledger",
    "fail-closed",
    "governance",
    "llm",
    "agent-ops"
  ],
  "author": "the Sakk authors",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/sakk-dev/sakk.git"
  },
  "bugs": {
    "url": "https://github.com/sakk-dev/sakk/issues"
  },
  "homepage": "https://github.com/sakk-dev/sakk#readme",
  "files": [
    "src",
    "bin",
    "policies",
    "prices",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
