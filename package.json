{
  "name": "sakk",
  "version": "0.1.0",
  "description": "The original check, rebuilt for AI agents \u2014 a fail-closed spend ledger: reserve before you spawn, settle with real costs, refuse everything pathological.",
  "type": "module",
  "main": "src/ledger.mjs",
  "exports": {
    ".": "./src/ledger.mjs",
    "./policy": "./src/policy.mjs"
  },
  "bin": {
    "sakk": "bin/sakk.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:eval": "node eval/bin/gold-runner.mjs --validate && node --test eval/__tests__/*.test.mjs",
    "test:all": "npm test && npm run test:eval",
    "drill": "sh scripts/mutation-drill.sh",
    "format": "npx -y prettier@3.9.10 --write .",
    "format:check": "npx -y prettier@3.9.10 --check .",
    "fuzz": "node scripts/invariant-fuzz.mjs",
    "fuzz:policy": "node scripts/policy-fuzz.mjs",
    "certificate": "node scripts/gate-certificate.mjs",
    "evidence": "node scripts/evidence-bundle.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "keywords": [
    "ai-agents",
    "budget",
    "spend-gate",
    "ledger",
    "fail-closed",
    "governance",
    "llm",
    "agent-ops"
  ],
  "author": "the Sakk authors",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/sakk-dev/sakk.git"
  },
  "bugs": {
    "url": "https://github.com/sakk-dev/sakk/issues"
  },
  "homepage": "https://github.com/sakk-dev/sakk#readme",
  "files": [
    "src",
    "bin",
    "policies",
    "README.md",
    "LICENSE"
  ]
}
