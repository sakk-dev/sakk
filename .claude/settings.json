{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$(git -C \"$CLAUDE_PROJECT_DIR\" config core.hooksPath)\" = scripts/hooks ] || exit 0; sh \"$CLAUDE_PROJECT_DIR/scripts/stop-gate.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$(git -C \"$CLAUDE_PROJECT_DIR\" config core.hooksPath)\" = scripts/hooks ] || exit 0; node \"$CLAUDE_PROJECT_DIR/scripts/findings-check.mjs\" --edit"
          }
        ]
      }
    ]
  }
}
