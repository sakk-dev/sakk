{
  "schema": "sakk-policy.v1",
  "default_verdict": "deny",
  "rules": [
    {
      "id": "protect-secret-files",
      "match": {
        "action": "secret.read"
      },
      "verdict": "deny"
    },
    {
      "id": "shell-destructive",
      "match": {
        "action": "git.destructive"
      },
      "verdict": "deny"
    },
    {
      "id": "deny-prod-delete",
      "match": {
        "action": "prod.delete"
      },
      "verdict": "deny"
    },
    {
      "id": "deny-delete-protected",
      "match": {
        "action": "file.delete",
        "scope": ["~protected/"]
      },
      "verdict": "deny"
    },
    {
      "id": "allow-temp-cleanup",
      "match": {
        "action": "file.delete",
        "scope": [
          "~outside/tmp/",
          "~outside/private/tmp/",
          "~outside/var/folders/",
          "~outside/private/var/folders/"
        ]
      },
      "verdict": "allow"
    },
    {
      "id": "deny-rm-outside-repo",
      "match": {
        "action": "file.delete",
        "scope": ["~outside/", "~home/"]
      },
      "verdict": "deny"
    },
    {
      "id": "protect-guard-state",
      "match": {
        "action": "file.write",
        "scope": [".sakk/", "~sakk/"]
      },
      "verdict": "deny"
    },
    {
      "id": "protect-guard-state-delete",
      "match": {
        "action": "file.delete",
        "scope": [".sakk/", "~sakk/"]
      },
      "verdict": "deny"
    },
    {
      "id": "protect-ci-files",
      "match": {
        "action": "file.write",
        "scope": [".github/workflows/"]
      },
      "verdict": "deny"
    },
    {
      "id": "protect-migrations",
      "match": {
        "action": "file.delete",
        "scope": ["migrations/", "db/migrations/"]
      },
      "verdict": "deny"
    },
    {
      "id": "ask-agent-config",
      "match": {
        "action": "file.write",
        "scope": [".claude/", ".cursor/", ".codex/"]
      },
      "verdict": "require_approval",
      "approvers_min": 1
    },
    {
      "id": "high-risk-deploy",
      "match": {
        "action": "deploy"
      },
      "verdict": "require_approval",
      "approvers_min": 1
    },
    {
      "id": "ask-constructed-commands",
      "match": {
        "action": "shell.constructed"
      },
      "verdict": "require_approval",
      "approvers_min": 1
    },
    {
      "id": "allow-in-repo",
      "match": {},
      "verdict": "allow"
    }
  ]
}
